#!/bin/bash

echo "--- [START] Executing post_compile hook ---"

CACHE_DIR="/app/.cache"

if [ -d "$CACHE_DIR" ]; then
  echo "SUCCESS: Found cache directory at $CACHE_DIR"
  echo "Listing contents before deletion:"
  ls -lah "$CACHE_DIR"
  
  echo "Now, deleting cache directory to reduce slug size..."
  rm -rf "$CACHE_DIR"
  echo "SUCCESS: Deletion complete."
else
  echo "WARNING: Cache directory $CACHE_DIR was not found."
fi

echo "--- [END] Finished post_compile hook ---" 